{
  "name": "stellar-agent-kit",
  "version": "1.0.0",
  "description": "Modular, secure Stellar Agent Kit with PayFi / x402 support",
  "private": true,
  "scripts": {
    "setup": "npx ts-node scripts/setup.ts",
    "build": "tsc",
    "pretest": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:fuzz": "vitest run tests/fuzz/**",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ts:coverage": "vitest run --coverage",
    "test:rust": "cargo test --locked --manifest-path contracts/escrow/Cargo.toml",
    "test:rust:coverage": "cargo tarpaulin --locked --manifest-path contracts/escrow/Cargo.toml --out Html --output-dir coverage/rust",
    "check:wasm-size": "bash scripts/check_wasm_size.sh",
    "test:e2e": "vitest run tests/e2e/**",
    "test:all": "npm run test:rust && npm run test:ts",
    "test:mutation": "stryker run stryker.config.mjs",
    "lint": "eslint backend/**/*.ts tests/**/*.ts",
    "format": "prettier --write \"backend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"backend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky install",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "docs:generate": "typedoc"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "eslint --fix"
    ],
    "tests/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1121.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@stellar/stellar-sdk": "13.3.0",
    "axios": "1.20.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "opossum": "8.5.0",
    "pino": "10.3.1",
    "toml": "5.0.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "toml": "5.0.0",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/opossum": "8.1.9",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "conventional-changelog-cli": "5.0.0",
    "eslint": "8.57.1",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
